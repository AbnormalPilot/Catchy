			</dict>
			<key>NSMessage</key>
			<string>catchText</string>
			<key>NSPortName</key>
			<string>Catchy</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
